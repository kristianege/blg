Option Explicit

'' =========================================
'' modHelpers - Hjælpebibliotek for arket
'' =========================================

' --- KONSTANTER ---
Public Const ColGreen As Long = vbGreen   ' Standard Grøn
Public Const ColYellow As Long = vbYellow ' Standard Gul
Public Const ColBlue As Long = vbBlue     ' Standard Blå
Public Const ColPurple As Long = 10498160 ' En lilla farve til Ferie

' Returnerer de tilladte koder ét sted
Public Function GetCodes() As Variant
    ' Opdateret liste inkl. "n" og "m" som varianter af Kemi
    GetCodes = Array("Q", "H", "k", "n", "m", "s", "f", "a", "j", "u", "X")
End Function

' --- Hjælpe funktioner ---
Sub SafeSetValue(ByVal c As Range, ByVal v As Variant)
    On Error GoTo SafeSetErr
    Application.EnableEvents = False
    c.Value = v
SafeSetExit:
    Application.EnableEvents = True
    Exit Sub
SafeSetErr:
    Application.EnableEvents = True
    Resume SafeSetExit
End Sub

Function NormalizeCellText(ByVal s As String) As String
    Dim Codes As Variant
    Dim i As Long, j As Long
    Dim ch As String
    Dim out As String
    Codes = GetCodes()
    out = ""
    For j = 1 To Len(s)
        ch = Mid$(s, j, 1)
        If ch Like "[A-Za-z]" Then
            ' Sammenlign tegnet med alle tilladte koder (case-insensitive)
            For i = LBound(Codes) To UBound(Codes)
                If StrComp(ch, Codes(i), vbTextCompare) = 0 Then
                    out = out & Codes(i)
                    Exit For
                End If
            Next i
        ElseIf ch = " " Or ch = "," Then
            out = out & ch
        End If
    Next j
    out = Replace(out, ",", " ")
    Do While InStr(out, "  ") > 0
        out = Replace(out, "  ", " ")
    Loop
    NormalizeCellText = Trim$(out)
End Function

Sub ApplyStyleForCodes(ByVal c As Range, ByVal cleaned As String)
    If InStr(1, cleaned, "X", vbBinaryCompare) > 0 Then
        ' Ferie
        c.Interior.Pattern = xlPatternGray75
        c.Interior.Color = vbBlack
        c.Interior.PatternColor = vbWhite
        c.Font.Bold = True
        c.Font.Color = vbRed
    ElseIf cleaned <> "" Then
        ' Normal indtastning
        c.Interior.Pattern = xlNone
        c.Interior.Color = ColYellow
        c.Font.Bold = False
        c.Font.Color = vbBlack
    Else
        ' Tom celle
        c.Interior.Pattern = xlNone
        c.Interior.ColorIndex = xlNone
        c.Font.Bold = False
        c.Font.Color = vbBlack
    End If
End Sub
