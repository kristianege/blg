' --- KONSTANTER ---
Public Const ColGreen As Long = vbGreen
Public Const ColYellow As Long = vbYellow
Public Const ColBlue As Long = vbBlue
Public Const ColPurple As Long = 10498160

' Autosluk interval i minutter
Public Const AutoCloseMinutes As Long = 15

' Timer variable
Public RunTime As Date
Public WarnTime As Date
Public WarnRemainingSeconds As Long
Public WarnUpdateTime As Date


' ==========================================
'  DEL 1: LOGIK TIL FARVESKIFT
' ==========================================

Sub MarkerSomProvesvar()
    ' Opdateret til at starte fra række 14 (da vi har tilføjet flere koder)
    Dim DataRange As Range
    Set DataRange = ActiveSheet.Range("E14:BD500")
    
    If Not Intersect(ActiveCell, DataRange) Is Nothing Then
        ActiveCell.FormatConditions.Delete
        
        If ActiveCell.Value <> "" And UCase(ActiveCell.Value) <> "X" Then
            If ActiveCell.Interior.Pattern = xlPatternLightUp Then
                ' Er Låst -> Skift tilbage til Grøn (Udført)
                ActiveCell.Interior.Pattern = xlNone
                ActiveCell.Interior.Color = ColGreen
            Else
                ' Er ikke Låst -> Skift til Blå med Røde striber
                ActiveCell.Interior.Color = ColBlue
                ActiveCell.Interior.Pattern = xlPatternLightUp
                ActiveCell.Interior.PatternColor = vbRed
            End If
        End If
    End If
    ResetTimer
End Sub


' ==========================================
'  DEL 2: BYG ARKET (DESIGN)
' ==========================================
Sub BygMitArk()
    Dim ws As Worksheet
    Dim i As Integer
    Dim Codes As Variant
    Dim Descriptions As Variant
    Dim DataStartRow As Integer
    Dim HeaderRow As Integer
    Dim NumCodes As Integer
    Dim ButtonRow As Integer ' NY: Dynamisk række til knapper
    
    Dim btnCopy As Shape
    Dim btnReset As Shape
    Dim btnLeftCopy As Double, btnWidthCopy As Double
    Dim btnLeftReset As Double, btnWidthReset As Double
    
    Application.EnableEvents = False
    On Error GoTo Cleanup
    
    Set ws = ActiveSheet
    ws.Cells.Clear
    ws.DrawingObjects.Delete
    ws.Cells.FormatConditions.Delete
    
    ' Hent koder fra modHelpers
    Codes = GetCodes()
    
    ' Opdateret liste med beskrivelser der matcher rækkefølgen i GetCodes
    Descriptions = Array("Vandføringsmåling", "Vandstand", "Kemi", _
                         "Kemi (variant n)", "Kemi (variant m)", _
                         "Salinitet", "Jern", "Alkalinitet", _
                         "Jordvand", "Jordvand udvidet", "FERIE")
    
    NumCodes = UBound(Codes) + 1
    
    ' BEREGN LAYOUT DYNAMISK
    ' Vejledningen fylder række 1 til NumCodes.
    ' Knapperne skal ligge lige under vejledningen.
    ButtonRow = NumCodes + 1
    HeaderRow = ButtonRow + 1
    DataStartRow = HeaderRow + 1
    
    ' Vejledning
    With ws.Range(ws.Cells(1, 1), ws.Cells(NumCodes, 1))
        .Merge
        .Value = "VEJLEDNING:" & vbCrLf & vbCrLf & _
                 "• Dobbeltklik:" & vbCrLf & "  Udført (Grøn)" & vbCrLf & vbCrLf & _
                 "• Ctrl + m:" & vbCrLf & "  Prøvesvar (Stribet)" & vbCrLf & vbCrLf & _
                 "• X = Ferie"
        .VerticalAlignment = xlCenter
        .HorizontalAlignment = xlLeft
        .WrapText = True
        .Interior.Color = RGB(245, 245, 245)
        .Font.Size = 9
        .Borders.LineStyle = xlContinuous
    End With

    ' Koder C+D
    For i = 0 To UBound(Codes)
        ws.Cells(i + 1, 4).Value = Codes(i)
        With ws.Cells(i + 1, 4)
            .Font.Bold = True
            .Interior.Color = RGB(200, 200, 200)
            .HorizontalAlignment = xlCenter
            .VerticalAlignment = xlCenter
            .Borders.LineStyle = xlContinuous
        End With
        
        ws.Cells(i + 1, 3).Value = Descriptions(i)
        With ws.Cells(i + 1, 3)
            .Font.Italic = True
            .VerticalAlignment = xlCenter
            .HorizontalAlignment = xlRight
            .Interior.Color = xlNone
        End With
        
        ' Formel til optælling - bruger nu DataStartRow dynamisk
        If Codes(i) <> "X" Then
            ws.Range(ws.Cells(i + 1, 5), ws.Cells(i + 1, 56)).FormulaR1C1 = _
                "=COUNTIF(R" & DataStartRow & "C:R500C, ""*"" & RC4 & ""*"")"
        End If
    Next i
    
    ' --- KNAPPER (Bruger nu ButtonRow i stedet for hardkodet 10) ---
    
    ' Knap: Kopier
    btnLeftCopy = ws.Cells(ButtonRow, 2).Left + 4
    btnWidthCopy = ws.Cells(ButtonRow, 2).Width - 8
    Set btnCopy = ws.Shapes.AddShape(msoShapeRoundedRectangle, _
        btnLeftCopy, ws.Cells(ButtonRow, 2).Top + 3, _
        btnWidthCopy, ws.Cells(ButtonRow, 2).Height - 6)
    With btnCopy
        .TextFrame.Characters.Text = "Kopier markering"
        .TextFrame.Characters.Font.Size = 8
        .TextFrame.Characters.Font.Bold = True
        .TextFrame.HorizontalAlignment = xlHAlignCenter
        .TextFrame.VerticalAlignment = xlVAlignCenter
        .Fill.ForeColor.RGB = RGB(70, 130, 180)
        .Line.Visible = msoFalse
        .OnAction = "KopierMarkering"
    End With
    
    ' Knap: Reset
    ws.Rows(ButtonRow).RowHeight = 25
    btnLeftReset = ws.Cells(ButtonRow, 1).Left + 4
    btnWidthReset = ws.Cells(ButtonRow, 1).Width - 8
    Set btnReset = ws.Shapes.AddShape(msoShapeRoundedRectangle, _
        btnLeftReset, ws.Cells(ButtonRow, 1).Top + 3, _
        btnWidthReset, ws.Cells(ButtonRow, 1).Height - 6)
    With btnReset
        .TextFrame.Characters.Text = "GENSTART"
        .TextFrame.Characters.Font.Size = 8
        .TextFrame.Characters.Font.Bold = True
        .TextFrame.HorizontalAlignment = xlHAlignCenter
        .TextFrame.VerticalAlignment = xlVAlignCenter
        .Fill.ForeColor.RGB = RGB(200, 0, 0)
        .Line.Visible = msoFalse
        .OnAction = "NodGenstart"
    End With
    
    ' --- INPUT FELTER (Bruger nu ButtonRow) ---
    ws.Cells(ButtonRow, 3).Value = "VÆLG UGE:"
    With ws.Cells(ButtonRow, 3)
        .Font.Bold = True
        .HorizontalAlignment = xlRight
        .VerticalAlignment = xlCenter
        .Font.Size = 9
    End With
    
    With ws.Cells(ButtonRow, 4)
        .Value = Application.IsoWeekNum(Date)
        .Interior.Color = RGB(255, 255, 0)
        .Font.Bold = True
        .HorizontalAlignment = xlCenter
        .Borders.LineStyle = xlContinuous
        .Validation.Delete
        .Validation.Add Type:=xlValidateWholeNumber, AlertStyle:=xlValidAlertStop, Formula1:="1", Formula2:="52"
    End With

    ' --- HEADERS & DATA ---
    ws.Cells(HeaderRow, 1).Value = "Togt"
    ws.Cells(HeaderRow, 2).Value = "Stations navn"
    ws.Cells(HeaderRow, 3).Value = "St. nr."
    ws.Cells(HeaderRow, 4).Value = "INDHOLD" & vbCrLf & "VALGT UGE"
    
    ' Formel der henter uge-indhold: Nu dynamisk med ButtonRow for ugenummeret
    ws.Range(ws.Cells(DataStartRow, 4), ws.Cells(500, 4)).FormulaR1C1 = _
        "=IFERROR(INDEX(RC5:RC56, R" & ButtonRow & "C4), """")"
        
    With ws.Range(ws.Cells(DataStartRow, 4), ws.Cells(500, 4))
        .Interior.Color = RGB(255, 245, 230)
        .Font.Bold = True
        .HorizontalAlignment = xlCenter
        .Borders.LineStyle = xlContinuous
        .Borders(xlEdgeRight).LineStyle = xlDouble
        .Locked = True
        .NumberFormat = "0;;;@"
    End With

    For i = 1 To 52
        ws.Cells(HeaderRow, i + 4).Value = i
    Next i
    
    ' Formatering højre kant
    With ws.Range("BD1:BD500").Borders(xlEdgeRight)
        .LineStyle = xlContinuous
        .Weight = xlThick
        .Color = RGB(0, 0, 0)
    End With
    
    ' Optællings-kolonner (Ude til højre)
    Dim CurrentCol As Integer
    CurrentCol = 57
    For i = 0 To UBound(Codes)
        If Codes(i) <> "X" Then
            ws.Cells(HeaderRow, CurrentCol).Value = Codes(i)
            ws.Range(ws.Cells(DataStartRow, CurrentCol), ws.Cells(500, CurrentCol)).FormulaR1C1 = _
                "=COUNTIF(RC5:RC56, ""*"" & R" & HeaderRow & "C & ""*"")"
            CurrentCol = CurrentCol + 1
        End If
    Next i
    
    ws.Range("E1:BD" & NumCodes).NumberFormat = "0;;;@"
    ws.Range(ws.Cells(DataStartRow, 57), ws.Cells(500, 75)).NumberFormat = "0;;;@"
    
    With ws.Range(ws.Cells(HeaderRow, 1), ws.Cells(HeaderRow, CurrentCol - 1))
        .Font.Bold = True
        .Interior.Color = RGB(64, 64, 64)
        .Font.Color = vbWhite
        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter
    End With
    
    ' Layout bredder
    ws.Columns("A:A").ColumnWidth = 20
    ws.Columns("B:B").ColumnWidth = 12
    ws.Columns("C:C").ColumnWidth = 15
    ws.Columns("D:D").ColumnWidth = 10
    ws.Range(ws.Columns(5), ws.Columns(56)).ColumnWidth = 3
    ws.Range(ws.Columns(57), ws.Columns(75)).ColumnWidth = 4
    
    ' Frys ruder under headeren (DataStartRow)
    ws.Range("E" & DataStartRow).Select
    ActiveWindow.FreezePanes = True
    
    Application.MacroOptions Macro:="MarkerSomProvesvar", Description:="Blå/Rød", ShortcutKey:="m"
    
    Application.EnableEvents = True
    MsgBox "Arket er bygget og klar. Nye koder er tilføjet, og layoutet er justeret.", vbInformation
    Exit Sub

Cleanup:
    Application.EnableEvents = True
    MsgBox "Fejl: " & Err.Description, vbCritical
End Sub

' ==========================================
'  DEL 3: HJÆLPEFUNKTIONER & TIMER
' ==========================================

Sub NodGenstart()
    Application.EnableEvents = True
    On Error Resume Next
    ' Rettet til række 14
    ActiveSheet.Range("E14:BD500").FormatConditions.Delete
    On Error GoTo 0
    MsgBox "Systemet er genstartet.", vbInformation
End Sub

Sub KopierMarkering()
    Dim Cell As Range
    Dim RowStr As String
    Dim FinalStr As String
    Dim SelRange As Range
    Dim r As Range
    
    If TypeName(Selection) <> "Range" Then Exit Sub
    Set SelRange = Selection
    
    For Each r In SelRange.Rows
        RowStr = ""
        For Each Cell In r.Cells
            If Cell.Value <> "" Then RowStr = RowStr & Cell.Value & " "
        Next Cell
        If Trim(RowStr) <> "" Then FinalStr = FinalStr & Trim(RowStr) & ", "
    Next r
    
    If Len(FinalStr) > 0 Then
        FinalStr = Left(FinalStr, Len(FinalStr) - 2)
        With CreateObject("htmlfile")
            .ParentWindow.ClipboardData.SetData "text", FinalStr
        End With
        MsgBox "Kopieret: " & FinalStr, vbInformation
    End If
    ResetTimer
End Sub

' --- TIMER LOGIK (Uændret) ---
Sub StartTimer()
    StopTimer
    RunTime = Now + TimeSerial(0, AutoCloseMinutes, 0)
    WarnTime = RunTime - TimeSerial(0, 5, 0)
    On Error Resume Next
    If NameExists("AutoCloseRunTime") Then ThisWorkbook.Names("AutoCloseRunTime").Delete
    If NameExists("AutoCloseWarnTime") Then ThisWorkbook.Names("AutoCloseWarnTime").Delete
    ThisWorkbook.Names.Add Name:="AutoCloseRunTime", RefersTo:="=""" & Format$(RunTime, "yyyy-mm-dd HH:NN:SS") & """"
    ThisWorkbook.Names.Add Name:="AutoCloseWarnTime", RefersTo:="=""" & Format$(WarnTime, "yyyy-mm-dd HH:NN:SS") & """"
    UpdateCloseTimeCell RunTime
    Application.OnTime WarnTime, "WarnBeforeClose"
    Application.OnTime RunTime, "CloseAndSave"
    On Error GoTo 0
End Sub

Sub StopTimer()
    On Error Resume Next
    Application.OnTime RunTime, "CloseAndSave", , False
    Application.OnTime WarnTime, "WarnBeforeClose", , False
    Application.OnTime WarnUpdateTime, "UpdateWarn", , False
    If NameExists("AutoCloseRunTime") Then ThisWorkbook.Names("AutoCloseRunTime").Delete
    If NameExists("AutoCloseWarnTime") Then ThisWorkbook.Names("AutoCloseWarnTime").Delete
    ClearCloseTimeCell
    On Error GoTo 0
End Sub

Sub ResetTimer()
    StopTimer
    StartTimer
End Sub

Sub CloseAndSave()
    On Error Resume Next
    Application.DisplayAlerts = False
    If Not ThisWorkbook.ReadOnly Then ThisWorkbook.Save
    ThisWorkbook.Close
End Sub

Sub StartWarningCountdown(ByVal seconds As Long)
    WarnRemainingSeconds = seconds
    WarnUpdateTime = Now + TimeSerial(0, 0, 1)
    Application.OnTime WarnUpdateTime, "UpdateWarn"
End Sub

Function NameExists(ByVal nm As String) As Boolean
    On Error Resume Next
    Dim t As String
    t = ThisWorkbook.Names(nm).Name
    NameExists = (Err.Number = 0)
    Err.Clear
    On Error GoTo 0
End Function

Sub UpdateCloseTimeCell(ByVal t As Date)
    On Error Resume Next
    Dim ws As Worksheet
    Set ws = ThisWorkbook.ActiveSheet
    If ws Is Nothing Then Exit Sub
    SafeSetValue ws.Range("B1"), "Lukker kl: " & Format$(t, "hh:nn")
    On Error GoTo 0
End Sub

Sub ClearCloseTimeCell()
    On Error Resume Next
    Dim ws As Worksheet
    Set ws = ThisWorkbook.ActiveSheet
    If ws Is Nothing Then Exit Sub
    SafeSetValue ws.Range("B1"), ""
    On Error GoTo 0
End Sub

Sub ApplyManualCloseTime(ByVal rng As Range)
    On Error GoTo ErrHandler
    Dim txt As String
    txt = Trim$(CStr(rng.Value))
    If txt = "" Then
        StopTimer
        Exit Sub
    End If

    Dim raw As String
    raw = Replace$(txt, "Lukker kl:", "", 1, -1, vbTextCompare)
    raw = Trim$(raw)

    Dim dt As Date
    On Error Resume Next
    dt = CDate(raw)
    If Err.Number <> 0 Then
        Err.Clear
        If InStr(raw, ":") > 0 Then
            dt = Date + TimeValue(raw)
            If dt <= Now Then dt = dt + 1
        Else
            Err.Raise vbObjectError + 513, , "Ugyldigt format"
        End If
    End If
    On Error GoTo 0

    On Error Resume Next
    Application.OnTime WarnUpdateTime, "UpdateWarn", , False
    Application.OnTime RunTime, "CloseAndSave", , False
    Application.OnTime WarnTime, "WarnBeforeClose", , False
    On Error GoTo 0

    RunTime = dt
    WarnTime = RunTime - TimeSerial(0, 5, 0)

    On Error Resume Next
    If NameExists("AutoCloseRunTime") Then ThisWorkbook.Names("AutoCloseRunTime").Delete
    If NameExists("AutoCloseWarnTime") Then ThisWorkbook.Names("AutoCloseWarnTime").Delete
    ThisWorkbook.Names.Add Name:="AutoCloseRunTime", RefersTo:="=""" & Format$(RunTime, "yyyy-mm-dd HH:NN:SS") & """"
    ThisWorkbook.Names.Add Name:="AutoCloseWarnTime", RefersTo:="=""" & Format$(WarnTime, "yyyy-mm-dd HH:NN:SS") & """"
    On Error GoTo 0

    Application.OnTime WarnTime, "WarnBeforeClose"
    Application.OnTime RunTime, "CloseAndSave"
    UpdateCloseTimeCell RunTime
    Exit Sub

ErrHandler:
    MsgBox "Kunne ikke tolke tidspunktet i B1. Brug 'Lukker kl: HH:MM'", vbExclamation
End Sub

Sub UpdateWarn()
    On Error Resume Next
    If WarnRemainingSeconds <= 0 Then
        Application.StatusBar = False
        Exit Sub
    End If

    Dim mins As Long, secs As Long
    mins = WarnRemainingSeconds \ 60
    secs = WarnRemainingSeconds Mod 60
    Application.StatusBar = "Autosluk om " & Format$(mins, "00") & ":" & Format$(secs, "00") & " (tryk Esc eller Annuller for at beholde arket)"

    WarnRemainingSeconds = WarnRemainingSeconds - 1
    If WarnRemainingSeconds <= 0 Then
        Application.StatusBar = False
        CloseAndSave
    Else
        WarnUpdateTime = Now + TimeSerial(0, 0, 1)
        Application.OnTime WarnUpdateTime, "UpdateWarn"
    End If
End Sub

Sub CancelWarning()
    On Error Resume Next
    Application.OnTime WarnUpdateTime, "UpdateWarn", , False
    WarnRemainingSeconds = 0
    Application.StatusBar = False
    On Error GoTo 0
End Sub

' ==========================================
'  DEL 4: HÅNDTERING AF INDTASTNING
' ==========================================

Sub HåndterIndtastning(TargetRange As Range)
    Dim Cell As Range
    Dim s As String
    Dim cleaned As String
    
    For Each Cell In TargetRange
        If Trim(CStr(Cell.Value)) <> "" Then
            s = CStr(Cell.Value)
            cleaned = NormalizeCellText(s)
            
            If cleaned <> CStr(Cell.Value) Then
                SafeSetValue Cell, cleaned
            End If
            ApplyStyleForCodes Cell, cleaned
        Else
            ApplyStyleForCodes Cell, vbNullString
        End If
    Next Cell
    ResetTimer
End Sub

Sub HåndterDobbeltklik(Target As Range, Cancel As Boolean)
    If Target.Value <> "" Then
        On Error Resume Next
        If Target.Interior.Color = ColPurple Then
            Cancel = True
            On Error GoTo 0
            Exit Sub
        End If

        Dim curColor As Long
        curColor = Target.Interior.Color

        If curColor = ColGreen Then
            Target.Interior.Pattern = xlNone
            Target.Interior.Color = ColYellow
        Else
            Target.Interior.Pattern = xlNone
            Target.Interior.Color = ColGreen
        End If

        On Error GoTo 0
        Cancel = True
    End If
    ResetTimer
End Sub

Sub WarnBeforeClose()
    Dim ans As VbMsgBoxResult
    StartWarningCountdown 300

    ans = MsgBox("Advarsel: Lukker om 5 minutter." & vbCrLf & _
                 "Vil du lukke nu?", _
                 vbYesNo + vbExclamation, "Autosluk - advarsel")

    If ans = vbYes Then
        CancelWarning
        CloseAndSave
    Else
        CancelWarning
        ResetTimer
    End If
End Sub

