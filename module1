Option Explicit
'' =========================================
'' module1 - Hovedlogik for indtastning, styling og autosluk
''
'' Formål og samspil:
'' - Indeholder event-drevet logik til at håndtere input i området `E12:BD500`.
'' - Bruger hjælpefunktioner fra `modHelpers` (GetCodes, NormalizeCellText, ApplyStyleForCodes, SafeSetValue).
'' - Styrer autosluk via Application.OnTime (StartTimer/StopTimer/ResetTimer).
'' - Key binding: `MarkerSomProvesvar` er bundet til Ctrl+M og giver en stribet blå markering.
''
'' Vigtige procedurer:
'' - BygMitArk: opsætter arket (knapper, headers, formler)
'' - HåndterIndtastning: validerer og formaterer input (kaldes fra Worksheet_Change)
'' - HåndterDobbeltklik: toggler udført/ikke-udført ved dobbeltklik (kaldes fra Worksheet_BeforeDoubleClick)
'' - StartTimer/StopTimer/ResetTimer: styrer autosluk og advarsler
'' - WarnBeforeClose/StartWarningCountdown/UpdateWarn/CancelWarning: advarselsflow med nedtælling
'' =========================================

' --- KONSTANTER TIL FARVER (SÅ DE ER ENS OVERALT) ---
Public Const ColGreen As Long = vbGreen   ' Standard Grøn
Public Const ColYellow As Long = vbYellow ' Standard Gul
Public Const ColBlue As Long = vbBlue     ' Standard Blå
Public Const ColPurple As Long = 10498160 ' En lilla farve til Ferie

' Autosluk interval i minutter
Public Const AutoCloseMinutes As Long = 15

' Timer variabel
Public RunTime As Date
Public WarnTime As Date
Public WarnRemainingSeconds As Long
Public WarnUpdateTime As Date

' ==========================================
'  DEL 1: LOGIK TIL FARVESKIFT (NY TAKTIK)
' ==========================================

' Kaldes ved Ctrl+m
'' MarkerSomProvesvar
'' ---------------------------------
'' Hurtigmarkering der sætter en stribet blå baggrund (prøvesvar)
'' - Bundet til Ctrl+M via `Workbook_Open`
'' - Virker kun i dataområdet `E12:BD500`
'' - Rydder betinget formatering først for at undgå konflikter
Sub MarkerSomProvesvar()
    Dim DataRange As Range
    Set DataRange = ActiveSheet.Range("E12:BD500")
    
    If Not Intersect(ActiveCell, DataRange) Is Nothing Then
        ' Slet betinget formatering
        ActiveCell.FormatConditions.Delete
        
        If ActiveCell.Value <> "" And UCase(ActiveCell.Value) <> "X" Then
            
            ' Tænd/Sluk logik
            If ActiveCell.Interior.Pattern = xlPatternLightUp Then
                ' Er Låst -> Skift tilbage til Grøn (Udført)
                ActiveCell.Interior.Pattern = xlNone
                ActiveCell.Interior.Color = ColGreen
            Else
                ' Er ikke Låst -> Skift til Blå med Røde striber
                ActiveCell.Interior.Color = ColBlue
                ActiveCell.Interior.Pattern = xlPatternLightUp
                ActiveCell.Interior.PatternColor = vbRed
            End If
            
        End If
    End If
    ResetTimer
End Sub


' ==========================================
'  DEL 2: BYG ARKET (DESIGN)
' ==========================================
Sub BygMitArk()
    ' BygMitArk
    ' ---------------------------------
    ' Opretter layoutet for arket, indsætter koder, beskrivelser, og
    ' formler som tæller forekomster. Denne procedure er et værktøj
    ' til at (re)initialisere arket og kan køres manuelt.
    Dim ws As Worksheet
    Dim i As Integer
    Dim Codes As Variant
    Dim Descriptions As Variant
    Dim DataStartRow As Integer
    Dim HeaderRow As Integer
    Dim NumCodes As Integer
    Dim btnCopy As Shape
    Dim btnReset As Shape
    Dim btnLeftCopy As Double, btnWidthCopy As Double
    Dim btnLeftReset As Double, btnWidthReset As Double
    
    Application.EnableEvents = True ' SIKKERHEDSNET
    Application.EnableEvents = False
    On Error GoTo Cleanup
    
    Set ws = ActiveSheet
    ws.Cells.Clear
    ws.DrawingObjects.Delete
    ws.Cells.FormatConditions.Delete ' Slet betinget formatering!
    
    Codes = GetCodes()
    Descriptions = Array("Vandføringsmåling", "Vandstand", "Kemi", "Salinitet", _
                         "Jern", "Alkalinitet", "Jordvand", "Jordvand udvidet", "FERIE")
    
    NumCodes = UBound(Codes) + 1
    HeaderRow = NumCodes + 2
    DataStartRow = HeaderRow + 1
    
    ' Vejledning
    With ws.Range(ws.Cells(1, 1), ws.Cells(NumCodes, 1))
        .Merge
        .Value = "VEJLEDNING:" & vbCrLf & vbCrLf & _
                 "• Dobbeltklik:" & vbCrLf & "  Udført (Grøn)" & vbCrLf & vbCrLf & _
                 "• Ctrl + m:" & vbCrLf & "  Prøvesvar (Stribet)" & vbCrLf & vbCrLf & _
                 "• X = Ferie" & vbCrLf & "  (Tælles ikke)"
        .VerticalAlignment = xlCenter
        .HorizontalAlignment = xlLeft
        .WrapText = True
        .Interior.Color = RGB(245, 245, 245)
        .Font.Size = 9
        .Borders.LineStyle = xlContinuous
    End With

    ' Koder C+D
    For i = 0 To UBound(Codes)
        ws.Cells(i + 1, 4).Value = Codes(i)
        With ws.Cells(i + 1, 4)
            .Font.Bold = True
            .Interior.Color = RGB(200, 200, 200)
            .HorizontalAlignment = xlCenter
            .VerticalAlignment = xlCenter
            .Borders.LineStyle = xlContinuous
        End With
        ws.Cells(i + 1, 3).Value = Descriptions(i)
        With ws.Cells(i + 1, 3)
            .Font.Italic = True
            .VerticalAlignment = xlCenter
            .HorizontalAlignment = xlRight
            .Interior.Color = xlNone
        End With
        If Codes(i) <> "X" Then
            ws.Range(ws.Cells(i + 1, 5), ws.Cells(i + 1, 56)).FormulaR1C1 = _
                "=COUNTIF(R" & DataStartRow & "C:R500C, ""*"" & RC4 & ""*"")"
        End If
    Next i
    
    ' Knap: Kopier (lidt mindre end cellebredden, centreret med indre polstring)
    btnLeftCopy = ws.Cells(10, 2).Left + 4
    btnWidthCopy = ws.Cells(10, 2).Width - 8
    Set btnCopy = ws.Shapes.AddShape(msoShapeRoundedRectangle, _
        btnLeftCopy, ws.Cells(10, 2).Top + 3, _
        btnWidthCopy, ws.Cells(10, 2).Height - 6)
    With btnCopy
        .TextFrame.Characters.Text = "Kopier markering"
        .TextFrame.Characters.Font.Size = 8
        .TextFrame.Characters.Font.Bold = True
        .TextFrame.HorizontalAlignment = xlHAlignCenter
        .TextFrame.VerticalAlignment = xlVAlignCenter
        .Fill.ForeColor.RGB = RGB(70, 130, 180)
        .Line.Visible = msoFalse
        .OnAction = "KopierMarkering"
    End With
    
    ' Knap: Reset (Nødhjælp) - lidt mindre end cellebredden, centreret
    ws.Range("A10").RowHeight = 25
    btnLeftReset = ws.Cells(10, 1).Left + 4
    btnWidthReset = ws.Cells(10, 1).Width - 8
    Set btnReset = ws.Shapes.AddShape(msoShapeRoundedRectangle, _
        btnLeftReset, ws.Cells(10, 1).Top + 3, _
        btnWidthReset, ws.Cells(10, 1).Height - 6)
    With btnReset
        .TextFrame.Characters.Text = "GENSTART"
        .TextFrame.Characters.Font.Size = 8
        .TextFrame.Characters.Font.Bold = True
        .TextFrame.HorizontalAlignment = xlHAlignCenter
        .TextFrame.VerticalAlignment = xlVAlignCenter
        .Fill.ForeColor.RGB = RGB(200, 0, 0)
        .Line.Visible = msoFalse
        .OnAction = "NodGenstart"
    End With
    
    ' Input felter
    ws.Cells(10, 3).Value = "VÆLG UGE:"
    With ws.Cells(10, 3)
        .Font.Bold = True
        .HorizontalAlignment = xlRight
        .VerticalAlignment = xlCenter
        .Font.Size = 9
    End With
    With ws.Cells(10, 4)
        .Value = Application.IsoWeekNum(Date)
        .Interior.Color = RGB(255, 255, 0)
        .Font.Bold = True
        .HorizontalAlignment = xlCenter
        .Borders.LineStyle = xlContinuous
        .Validation.Delete
        .Validation.Add Type:=xlValidateWholeNumber, AlertStyle:=xlValidAlertStop, Formula1:="1", Formula2:="52"
    End With

    ' Headers
    ws.Cells(HeaderRow, 1).Value = "Togt"
    ws.Cells(HeaderRow, 2).Value = "Stations navn"
    ws.Cells(HeaderRow, 3).Value = "St. nr."
    ws.Cells(HeaderRow, 4).Value = "INDHOLD" & vbCrLf & "VALGT UGE"
    
    ws.Range(ws.Cells(DataStartRow, 4), ws.Cells(500, 4)).FormulaR1C1 = "=IFERROR(INDEX(RC5:RC56, R10C4), """")"
    With ws.Range(ws.Cells(DataStartRow, 4), ws.Cells(500, 4))
        .Interior.Color = RGB(255, 245, 230)
        .Font.Bold = True
        .HorizontalAlignment = xlCenter
        .Borders.LineStyle = xlContinuous
        .Borders(xlEdgeRight).LineStyle = xlDouble
        .Locked = True
        .NumberFormat = "0;;;@"
    End With

    For i = 1 To 52
        ws.Cells(HeaderRow, i + 4).Value = i
    Next i
    
    ' Formatering
    With ws.Range("BD1:BD500").Borders(xlEdgeRight)
        .LineStyle = xlContinuous
        .Weight = xlThick
        .Color = RGB(0, 0, 0)
    End With
    
    Dim CurrentCol As Integer
    CurrentCol = 57
    For i = 0 To UBound(Codes)
        If Codes(i) <> "X" Then
            ws.Cells(HeaderRow, CurrentCol).Value = Codes(i)
            ws.Range(ws.Cells(DataStartRow, CurrentCol), ws.Cells(500, CurrentCol)).FormulaR1C1 = _
                "=COUNTIF(RC5:RC56, ""*"" & R" & HeaderRow & "C & ""*"")"
            CurrentCol = CurrentCol + 1
        End If
    Next i
    
    ws.Range("E1:BD" & NumCodes).NumberFormat = "0;;;@"
    ws.Range(ws.Cells(DataStartRow, 57), ws.Cells(500, 75)).NumberFormat = "0;;;@"
    
    With ws.Range(ws.Cells(HeaderRow, 1), ws.Cells(HeaderRow, CurrentCol - 1))
        .Font.Bold = True
        .Interior.Color = RGB(64, 64, 64)
        .Font.Color = vbWhite
        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter
    End With
    
    ' Layout
    ws.Columns("A:A").ColumnWidth = 20
    ws.Columns("B:B").ColumnWidth = 12
    ws.Columns("C:C").ColumnWidth = 15
    ws.Columns("D:D").ColumnWidth = 10
    ws.Range(ws.Columns(5), ws.Columns(56)).ColumnWidth = 3
    ws.Range(ws.Columns(57), ws.Columns(75)).ColumnWidth = 4
    ws.Range("E" & DataStartRow).Select
    ActiveWindow.FreezePanes = True
    
    ' Key binding
    Application.MacroOptions Macro:="MarkerSomProvesvar", Description:="Blå/Rød", ShortcutKey:="m"
    
    Application.EnableEvents = True
    MsgBox "Arket er bygget og klar.", vbInformation
    Exit Sub

Cleanup:
    Application.EnableEvents = True
    MsgBox "Fejl: " & Err.Description, vbCritical
End Sub

' ==========================================
'  DEL 3: HJÆLPEFUNKTIONER & TIMER
