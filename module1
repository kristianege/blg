Sub NodGenstart()
    ' NodGenstart
    ' ---------------------------------
    ' Nødprocedure der rydder betinget formatering i dataområdet.
    ' Kan bruges når arket opfører sig mærkeligt efter automatiske ændringer.
    Application.EnableEvents = True
    On Error Resume Next
    ' Sletter betinget formatering som ofte er synderen bag "flimmer"
    ActiveSheet.Range("E12:BD500").FormatConditions.Delete
    On Error GoTo 0
    MsgBox "Systemet er genstartet.", vbInformation
End Sub
 ' helpers moved to modHelpers module

Sub KopierMarkering()
    Dim Cell As Range
    Dim RowStr As String
    Dim FinalStr As String
    Dim SelRange As Range
    Dim r As Range
    
    If TypeName(Selection) <> "Range" Then Exit Sub
    Set SelRange = Selection
    
    For Each r In SelRange.Rows
        RowStr = ""
        For Each Cell In r.Cells
            If Cell.Value <> "" Then RowStr = RowStr & Cell.Value & " "
        Next Cell
        If Trim(RowStr) <> "" Then FinalStr = FinalStr & Trim(RowStr) & ", "
    Next r
    
    If Len(FinalStr) > 0 Then
        FinalStr = Left(FinalStr, Len(FinalStr) - 2)
        With CreateObject("htmlfile")
            .ParentWindow.ClipboardData.SetData "text", FinalStr
        End With
        MsgBox "Kopieret: " & FinalStr, vbInformation
    End If
    ResetTimer
End Sub

Sub StartTimer()
    ' StartTimer
    ' ---------------------------------
    ' Planlæg autosluk: først et advarselskald `WarnBeforeClose` og
    ' herefter selve `CloseAndSave`. Tidspunkt for luk er `AutoCloseMinutes`
    ' efter nu. StopTimer kaldes først for at sikre der ikke er gamle planer.
    StopTimer
    RunTime = Now + TimeSerial(0, AutoCloseMinutes, 0)
    ' Advarsel planlægges 5 minutter før luk
    WarnTime = RunTime - TimeSerial(0, 5, 0)
    On Error Resume Next
    Application.OnTime WarnTime, "WarnBeforeClose"
    Application.OnTime RunTime, "CloseAndSave"
    On Error GoTo 0
End Sub

Sub StopTimer()
    ' StopTimer
    ' ---------------------------------
    ' Afbestiller planlagte OnTime-kald (både advarsel og luk) og
    ' annullerer den per-sekund opdatering af advarsels-nedtællingen.
    On Error Resume Next
    Application.OnTime RunTime, "CloseAndSave", , False
    Application.OnTime WarnTime, "WarnBeforeClose", , False
    ' Annuller eventuel per-second UpdateWarn
    On Error Resume Next
    Application.OnTime WarnUpdateTime, "UpdateWarn", , False
    On Error GoTo 0
    On Error GoTo 0
End Sub

Sub ResetTimer()
    StopTimer
    StartTimer
End Sub

Sub CloseAndSave()
    ' Luk uden prompt (advarsel sendes tidligere). Dette kald kan være
    ' planlagt af OnTime — luk og gem automatisk.
    On Error Resume Next
    Application.DisplayAlerts = False
    If Not ThisWorkbook.ReadOnly Then ThisWorkbook.Save
    ThisWorkbook.Close
End Sub

Sub StartWarningCountdown(ByVal seconds As Long)
    ' Start per-second nedtælling, som opdaterer statuslinjen.
    ' Dokumentation:
    ' - Bruges af `WarnBeforeClose` til at vise en live nedtælling i statuslinjen
    ' - Gemmer tidspunktet i `WarnUpdateTime` så den kan annulleres via OnTime
    WarnRemainingSeconds = seconds
    ' Sæt første update til nu + 1 sek
    WarnUpdateTime = Now + TimeSerial(0, 0, 1)
    Application.OnTime WarnUpdateTime, "UpdateWarn"
End Sub

Sub UpdateWarn()
    ' UpdateWarn
    ' ---------------------------------
    ' Opdaterer `Application.StatusBar` hvert sekund med resterende tid.
    ' Hvis nedtællingen når 0, udløses `CloseAndSave`.
    On Error Resume Next
    ' Hvis timer er afbrudt, ryd status og stop
    If WarnRemainingSeconds <= 0 Then
        Application.StatusBar = False
        Exit Sub
    End If

    Dim mins As Long, secs As Long
    mins = WarnRemainingSeconds \ 60
    secs = WarnRemainingSeconds Mod 60
    Application.StatusBar = "Autosluk om " & Format$(mins, "00") & ":" & Format$(secs, "00") & " (tryk Esc eller Annuller i advarselsdialog for at beholde arket)"

    WarnRemainingSeconds = WarnRemainingSeconds - 1
    If WarnRemainingSeconds <= 0 Then
        Application.StatusBar = False
        ' Kør luk
        CloseAndSave
    Else
        ' Planlæg næste update
        WarnUpdateTime = Now + TimeSerial(0, 0, 1)
        Application.OnTime WarnUpdateTime, "UpdateWarn"
    End If
End Sub

Sub CancelWarning()
    ' Stop per-second advarsel og ryd statusbar
    ' - Anvendes hvis brugeren vælger at annullere advarslen eller når timer
    '   genstartes/annulleres af anden årsag.
    On Error Resume Next
    Application.OnTime WarnUpdateTime, "UpdateWarn", , False
    WarnRemainingSeconds = 0
    Application.StatusBar = False
    On Error GoTo 0
End Sub

' ==========================================
'  DEL 4: HÅNDTERING AF INDTASTNING & DOBBELTKLIK
' ==========================================

Sub HåndterIndtastning(TargetRange As Range)
    ' HåndterIndtastning
    ' ---------------------------------
    ' Validerer og normaliserer indtastninger i dataområdet.
    ' Flow for hver celle i TargetRange:
    ' 1) Rens tekst via `NormalizeCellText` (fjern ugyldige tegn og normaliser case)
    ' 2) Skriv evt. den rensede værdi tilbage via `SafeSetValue` (undgå events)
    ' 3) Anvend visuel styling via `ApplyStyleForCodes`
    ' Bemærk: tomme celler får styling fjernet.
    Dim Cell As Range
    Dim Codes As Variant
    Dim i As Long
    Dim s As String
    Dim cleaned As String
    Dim ch As String
    Dim j As Long

    Codes = GetCodes()

    For Each Cell In TargetRange
        If Trim(CStr(Cell.Value)) <> "" Then
                s = CStr(Cell.Value) ' No-op change
            cleaned = NormalizeCellText(s)

            If cleaned <> CStr(Cell.Value) Then
                SafeSetValue Cell, cleaned
            End If

            ' Anvend styling afhængigt af renset værdi
            ApplyStyleForCodes Cell, cleaned
        Else
            ' Hvis cellen er tom (fx slettet), fjern baggrund og styling
            ApplyStyleForCodes Cell, vbNullString
        End If
    Next Cell
    ResetTimer
End Sub

Sub HåndterDobbeltklik(Target As Range, Cancel As Boolean)
    ' HåndterDobbeltklik
    ' ---------------------------------
    ' Dobbeltklik toggler en cellens status mellem "Udført" (grøn) og
    ' "Indtastet" (gul). Særlige regler:
    ' - Hvis cellen er markeret som FERIE (X) ignoreres dobbeltklik.
    ' - Forhindrer redigering efter dobbeltklik ved at sætte Cancel = True.
    ' - Når cellen er tom, fjernes baggrunden (det sker i HåndterIndtastning ved slet).
    If Target.Value <> "" Then
        On Error Resume Next
        ' Ignorer dobbeltklik for X-celler
        If Target.Interior.Color = ColPurple Then
            Cancel = True
            On Error GoTo 0
            Exit Sub
        End If

        Dim curColor As Long
        curColor = Target.Interior.Color

        If curColor = ColGreen Then
            ' Grøn -> skift til gul
            Target.Interior.Pattern = xlNone
            Target.Interior.Color = ColYellow
        Else
            ' Gul eller andet -> skift til grøn
            Target.Interior.Pattern = xlNone
            Target.Interior.Color = ColGreen
        End If

        On Error GoTo 0
        Cancel = True  ' Forhindrer redigering efter dobbeltklik
    End If
    ResetTimer
End Sub

Sub WarnBeforeClose()
    ' Vis advarsel 5 minutter før planlagt luk. Hvis bruger vælger Nej -> annuller/regenstart timer.
    Dim ans As VbMsgBoxResult
    ' Start per-second nedtælling (5 minutter = 300 sek)
    StartWarningCountdown 300

    ans = MsgBox("Advarsel: Denne projektmappe vil blive gemt og lukket om 5 minutter." & vbCrLf & _
                 "Klik 'Ja' for at lukke nu, eller 'Nej' for at annullere autosluk og fortsætte arbejdet.", _
                 vbYesNo + vbExclamation, "Autosluk - advarsel")

    If ans = vbYes Then
        ' Brugeren valgte at lukke nu: stop countdown og luk
        CancelWarning
        CloseAndSave
    Else
        ' Brugeren valgte Nej -> stop countdown og genstart timer fra nu
        CancelWarning
        ResetTimer
    End If
End Sub
