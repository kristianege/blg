Option Explicit

' --- KONSTANTER TIL FARVER (SÅ DE ER ENS OVERALT) ---
Public Const ColGreen As Long = 9498256   ' RGB(144, 238, 144) - Udført
Public Const ColYellow As Long = 14745599 ' RGB(255, 255, 224) - Planlagt
Public Const ColBlue As Long = 15128749   ' RGB(173, 216, 230) - Prøvesvar
Public Const ColPurple As Long = 8388736  ' RGB(128, 0, 128)   - Ferie

' Timer variabel
Public RunTime As Date

' ==========================================
'  DEL 1: LOGIK TIL FARVESKIFT (NY TAKTIK)
' ==========================================

' Kaldes når man skriver i en celle
Sub HåndterIndtastning(Target As Range)
    Dim Cell As Range
    Dim Txt As String
    
    ' Slå overvågning fra mens vi arbejder
    Application.EnableEvents = False
    On Error GoTo ExitHandler
    
    For Each Cell In Target
        If Cell.Value <> "" And Not Cell.HasFormula Then
            Txt = UCase(Cell.Value)
            
            ' 1. Ret til store bogstaver hvis nødvendigt
            If Cell.Value <> Txt Then Cell.Value = Txt
            
            ' 2. Bestem farve
            If InStr(1, Txt, "X") > 0 Then
                ' Ferie
                Cell.Interior.Color = ColPurple
                Cell.Font.Color = vbWhite
                Cell.Font.Bold = True
                Cell.Interior.Pattern = xlNone
            Else
                ' Normal - Gør KUN Gul hvis den er "ren" (dvs. ikke allerede Grøn/Blå)
                ' Dette sikrer at vi ikke overskriver en udført opgave ved en tastefejl
                Cell.Font.Color = vbBlack
                Cell.Font.Bold = False
                
                If Cell.Interior.Color = ColGreen Then
                    ' Behold Grøn
                ElseIf Cell.Interior.Pattern = xlPatternLightUp Then
                    ' Behold Striber
                Else
                    ' Sæt til Standard Gul
                    Cell.Interior.Color = ColYellow
                    Cell.Interior.Pattern = xlNone
                End If
            End If
        Else
            ' Tom celle - Ryd alt
            If Not Cell.HasFormula Then
                Cell.Interior.ColorIndex = xlNone
                Cell.Interior.Pattern = xlNone
                Cell.Font.Color = vbBlack
                Cell.Font.Bold = False
            End If
        End If
    Next Cell

ExitHandler:
    Application.EnableEvents = True
    ResetTimer
End Sub

' Kaldes når man Dobbeltklikker
Sub HåndterDobbeltklik(Target As Range, ByRef Cancel As Boolean)
    ' Slå events fra
    Application.EnableEvents = False
    On Error GoTo ExitHandler
    
    Cancel = True ' Stop excel fra at gå ind i cellen
    
    ' 1. Tjek om det er Ferie (X)
    If InStr(1, Target.Value, "X", vbTextCompare) > 0 Then GoTo ExitHandler
    
    ' 2. Tjek om det er Prøvesvar (Stribet) - Låst
    If Target.Interior.Pattern = xlPatternLightUp Then
        MsgBox "Prøvesvar er registreret." & vbCrLf & "Brug Ctrl+m for at ændre.", vbInformation
        GoTo ExitHandler
    End If
    
    ' 3. SKIFT MELLEM GRØN OG GUL (Selve logikken du efterspurgte)
    ' Vi bruger en lille margin i farvesammenligningen for robusthed
    If Target.Interior.Color = ColGreen Then
        ' Er den Grøn? -> Gør Gul
        Target.Interior.Color = ColYellow
    Else
        ' Er den Gul (eller hvid/andet)? -> Gør Grøn
        Target.Interior.Color = ColGreen
    End If
    
    ' Sikr at striber er væk
    Target.Interior.Pattern = xlNone

ExitHandler:
    Application.EnableEvents = True
    ResetTimer
End Sub

' Kaldes ved Ctrl+m
Sub MarkerSomProvesvar()
    Dim DataRange As Range
    Set DataRange = ActiveSheet.Range("E12:BD500")
    
    If Not Intersect(ActiveCell, DataRange) Is Nothing Then
        If ActiveCell.Value <> "" And UCase(ActiveCell.Value) <> "X" Then
            
            ' Tænd/Sluk logik
            If ActiveCell.Interior.Pattern = xlPatternLightUp Then
                ' Sluk -> Tilbage til Gul
                ActiveCell.Interior.Pattern = xlNone
                ActiveCell.Interior.Color = ColYellow
            Else
                ' Tænd -> Blå med Røde striber
                ActiveCell.Interior.Color = ColBlue
                ActiveCell.Interior.Pattern = xlPatternLightUp
                ActiveCell.Interior.PatternColor = vbRed
            End If
            
        End If
    End If
    ResetTimer
End Sub


' ==========================================
'  DEL 2: BYG ARKET (DESIGN)
' ==========================================
Sub BygMitArk()
    Dim ws As Worksheet
    Dim i As Integer
    Dim Codes As Variant
    Dim Descriptions As Variant
    Dim DataStartRow As Integer
    Dim HeaderRow As Integer
    Dim NumCodes As Integer
    Dim btnCopy As Shape
    Dim btnReset As Shape
    
    Application.EnableEvents = True ' SIKKERHEDSNET
    Application.EnableEvents = False
    On Error GoTo Cleanup
    
    Set ws = ActiveSheet
    ws.Cells.Clear
    ws.DrawingObjects.Delete
    ws.Cells.FormatConditions.Delete ' Slet betinget formatering!
    
    Codes = Array("Q", "H", "k", "s", "f", "a", "j", "u", "X")
    Descriptions = Array("Vandføringsmåling", "Vandstand", "Kemi", "Salinitet", _
                         "Jern", "Alkalinitet", "Jordvand", "Jordvand udvidet", "FERIE")
    
    NumCodes = UBound(Codes) + 1
    HeaderRow = NumCodes + 2
    DataStartRow = HeaderRow + 1
    
    ' Vejledning
    With ws.Range(ws.Cells(1, 1), ws.Cells(NumCodes, 1))
        .Merge
        .Value = "VEJLEDNING:" & vbCrLf & vbCrLf & _
                 "• Dobbeltklik:" & vbCrLf & "  Udført (Grøn)" & vbCrLf & vbCrLf & _
                 "• Ctrl + m:" & vbCrLf & "  Prøvesvar (Stribet)" & vbCrLf & vbCrLf & _
                 "• X = Ferie" & vbCrLf & "  (Tælles ikke)"
        .VerticalAlignment = xlCenter
        .HorizontalAlignment = xlLeft
        .WrapText = True
        .Interior.Color = RGB(245, 245, 245)
        .Font.Size = 9
        .Borders.LineStyle = xlContinuous
    End With

    ' Koder C+D
    For i = 0 To UBound(Codes)
        ws.Cells(i + 1, 4).Value = Codes(i)
        With ws.Cells(i + 1, 4)
            .Font.Bold = True
            .Interior.Color = RGB(200, 200, 200)
            .HorizontalAlignment = xlCenter
            .VerticalAlignment = xlCenter
            .Borders.LineStyle = xlContinuous
        End With
        ws.Cells(i + 1, 3).Value = Descriptions(i)
        With ws.Cells(i + 1, 3)
            .Font.Italic = True
            .VerticalAlignment = xlCenter
            .HorizontalAlignment = xlRight
            .Interior.Color = xlNone
        End With
        If Codes(i) <> "X" Then
            ws.Range(ws.Cells(i + 1, 5), ws.Cells(i + 1, 56)).FormulaR1C1 = _
                "=COUNTIF(R" & DataStartRow & "C:R500C, ""*"" & RC4 & ""*"")"
        End If
    Next i
    
    ' Knap: Kopier
    Set btnCopy = ws.Shapes.AddShape(msoShapeRoundedRectangle, _
        ws.Cells(10, 2).Left + 2, ws.Cells(10, 2).Top + 2, _
        ws.Cells(10, 2).Width - 4, ws.Cells(10, 2).Height - 4)
    With btnCopy
        .TextFrame.Characters.Text = "KOPIER"
        .TextFrame.Characters.Font.Size = 8
        .TextFrame.Characters.Font.Bold = True
        .TextFrame.HorizontalAlignment = xlHAlignCenter
        .TextFrame.VerticalAlignment = xlVAlignCenter
        .Fill.ForeColor.RGB = RGB(70, 130, 180)
        .Line.Visible = msoFalse
        .OnAction = "KopierMarkering"
    End With
    
    ' Knap: Reset (Nødhjælp)
    ws.Range("A10").RowHeight = 25
    Set btnReset = ws.Shapes.AddShape(msoShapeRoundedRectangle, _
        ws.Cells(10, 1).Left + 2, ws.Cells(10, 1).Top + 2, _
        ws.Cells(10, 1).Width - 4, ws.Cells(10, 1).Height - 4)
    With btnReset
        .TextFrame.Characters.Text = "GENSTART"
        .TextFrame.Characters.Font.Size = 8
        .TextFrame.Characters.Font.Bold = True
        .TextFrame.HorizontalAlignment = xlHAlignCenter
        .TextFrame.VerticalAlignment = xlVAlignCenter
        .Fill.ForeColor.RGB = RGB(200, 0, 0)
        .Line.Visible = msoFalse
        .OnAction = "NodGenstart"
    End With
    
    ' Input felter
    ws.Cells(10, 3).Value = "VÆLG UGE:"
    With ws.Cells(10, 3)
        .Font.Bold = True
        .HorizontalAlignment = xlRight
        .VerticalAlignment = xlCenter
        .Font.Size = 9
    End With
    With ws.Cells(10, 4)
        .Value = Application.IsoWeekNum(Date)
        .Interior.Color = RGB(255, 255, 0)
        .Font.Bold = True
        .HorizontalAlignment = xlCenter
        .Borders.LineStyle = xlContinuous
        .Validation.Delete
        .Validation.Add Type:=xlValidateWholeNumber, AlertStyle:=xlValidAlertStop, Formula1:="1", Formula2:="52"
    End With

    ' Headers
    ws.Cells(HeaderRow, 1).Value = "Togt"
    ws.Cells(HeaderRow, 2).Value = "Stations navn"
    ws.Cells(HeaderRow, 3).Value = "St. nr."
    ws.Cells(HeaderRow, 4).Value = "INDHOLD" & vbCrLf & "VALGT UGE"
    
    ws.Range(ws.Cells(DataStartRow, 4), ws.Cells(500, 4)).FormulaR1C1 = "=IFERROR(INDEX(RC5:RC56, R10C4), """")"
    With ws.Range(ws.Cells(DataStartRow, 4), ws.Cells(500, 4))
        .Interior.Color = RGB(255, 245, 230)
        .Font.Bold = True
        .HorizontalAlignment = xlCenter
        .Borders.LineStyle = xlContinuous
        .Borders(xlEdgeRight).LineStyle = xlDouble
        .Locked = True
        .NumberFormat = "0;;;@"
    End With

    For i = 1 To 52
        ws.Cells(HeaderRow, i + 4).Value = i
    Next i
    
    ' Formatering
    With ws.Range("BD1:BD500").Borders(xlEdgeRight)
        .LineStyle = xlContinuous
        .Weight = xlThick
        .Color = RGB(0, 0, 0)
    End With
    
    Dim CurrentCol As Integer
    CurrentCol = 57
    For i = 0 To UBound(Codes)
        If Codes(i) <> "X" Then
            ws.Cells(HeaderRow, CurrentCol).Value = Codes(i)
            ws.Range(ws.Cells(DataStartRow, CurrentCol), ws.Cells(500, CurrentCol)).FormulaR1C1 = _
                "=COUNTIF(RC5:RC56, ""*"" & R" & HeaderRow & "C & ""*"")"
            CurrentCol = CurrentCol + 1
        End If
    Next i
    
    ws.Range("E1:BD" & NumCodes).NumberFormat = "0;;;@"
    ws.Range(ws.Cells(DataStartRow, 57), ws.Cells(500, 75)).NumberFormat = "0;;;@"
    
    With ws.Range(ws.Cells(HeaderRow, 1), ws.Cells(HeaderRow, CurrentCol - 1))
        .Font.Bold = True
        .Interior.Color = RGB(64, 64, 64)
        .Font.Color = vbWhite
        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter
    End With
    
    ' Layout
    ws.Columns("A:A").ColumnWidth = 20
    ws.Columns("B:B").ColumnWidth = 12
    ws.Columns("C:C").ColumnWidth = 15
    ws.Columns("D:D").ColumnWidth = 10
    ws.Range(ws.Columns(5), ws.Columns(56)).ColumnWidth = 3
    ws.Range(ws.Columns(57), ws.Columns(75)).ColumnWidth = 4
    ws.Range("E" & DataStartRow).Select
    ActiveWindow.FreezePanes = True
    
    ' Key binding
    Application.MacroOptions Macro:="MarkerSomProvesvar", Description:="Blå/Rød", ShortcutKey:="m"
    
    Application.EnableEvents = True
    MsgBox "Arket er bygget og klar.", vbInformation
    Exit Sub

Cleanup:
    Application.EnableEvents = True
    MsgBox "Fejl: " & Err.Description, vbCritical
End Sub

' ==========================================
'  DEL 3: HJÆLPEFUNKTIONER & TIMER
' ==========================================

Sub NodGenstart()
    Application.EnableEvents = True
    MsgBox "Systemet er genstartet. Prøv at dobbeltklikke nu.", vbInformation
End Sub

Sub KopierMarkering()
    Dim Cell As Range
    Dim RowStr As String
    Dim FinalStr As String
    Dim SelRange As Range
    Dim r As Range
    
    If TypeName(Selection) <> "Range" Then Exit Sub
    Set SelRange = Selection
    
    For Each r In SelRange.Rows
        RowStr = ""
        For Each Cell In r.Cells
            If Cell.Value <> "" Then RowStr = RowStr & Cell.Value & " "
        Next Cell
        If Trim(RowStr) <> "" Then FinalStr = FinalStr & Trim(RowStr) & ", "
    Next r
    
    If Len(FinalStr) > 0 Then
        FinalStr = Left(FinalStr, Len(FinalStr) - 2)
        With CreateObject("htmlfile")
            .ParentWindow.ClipboardData.SetData "text", FinalStr
        End With
        MsgBox "Kopieret: " & FinalStr, vbInformation
    End If
    ResetTimer
End Sub

Sub StartTimer()
    StopTimer
    RunTime = Now + TimeValue("00:10:00")
    Application.OnTime RunTime, "CloseAndSave"
End Sub

Sub StopTimer()
    On Error Resume Next
    Application.OnTime RunTime, "CloseAndSave", , False
    On Error GoTo 0
End Sub

Sub ResetTimer()
    StopTimer
    StartTimer
End Sub

Sub CloseAndSave()
    Application.DisplayAlerts = False
    If Not ThisWorkbook.ReadOnly Then ThisWorkbook.Save
    ThisWorkbook.Close
End Sub
